# --- 必須（本番） ---
NODE_ENV=production
APP_URL=https://comsapo.example.com
ANTHROPIC_API_KEY=sk-ant-...
RESEND_API_KEY=re_...
MAIL_FROM="comsapo <no-reply@comsapo.example.com>"

# --- 課金（3つとも設定すると Plus プランが有効になる） ---
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
PLUS_PRICE_LABEL=月額 680円（税込）

# --- 任意 ---
# COMSAPO_MODEL=claude-opus-5-5
# AI_DAILY_BUDGET_USD=20        # 1日(UTC)のAI利用額の上限。超えるとAIを一時停止
# FREE_TALKS_PER_MONTH=2        # 無料プラン: 2人あたり月の話し合い回数
# PLUS_TALKS_PER_MONTH=30       # Plus: 2人あたり月の話し合い回数
# DATABASE_FILE=data/comsapo.db
